+/**
+ * Visits every object node bottom-up, in the same order as `traverse`, without copying the document.
+ * Kubb patch: the two passes that only collect references used `traverse`, which copied every object
+ * and was a third of the upgrade time on large documents.
+ */
+function walk(content, visit, path = []) {
+    for (const key of Object.keys(content)) {
+        const value = content[key];
+        if (Array.isArray(value)) {
+            for (let index = 0; index < value.length; index++) {
+                const item = value[index];
+                if (typeof item === 'object' && item !== null && !Array.isArray(item)) {
+                    walk(item, visit, [...path, key, String(index)]);
+                }
+            }
+        }
+        else if (value !== null && typeof value === 'object') {
+            walk(value, visit, [...path, key]);
+        }
+    }
+    visit(content, path);
+}
