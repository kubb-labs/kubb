{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsdown.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    },
    "start": {
      "dependsOn": [
        "^start"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": false
    }
  }
}
