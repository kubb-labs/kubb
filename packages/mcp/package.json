{
  "name": "@kubb/mcp",
  "version": "5.15.2",
  "description": "MCP server for Kubb. Exposes code generation as a tool over the Model Context Protocol so AI assistants like Claude, Cursor, and other MCP-compatible clients can generate TypeScript types, clients, and more.",
  "keywords": [
    "ai",
    "codegen",
    "kubb",
    "llm",
    "mcp",
    "meta-framework",
    "model-context-protocol",
    "typescript"
  ],
  "homepage": "https://kubb.dev",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/kubb.git",
    "directory": "packages/mcp"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "bin": {
    "kubb-mcp": "bin/kubb-mcp.cjs"
  },
  "files": [
    "dist",
    "bin",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "debug:mcp": "npx -y @modelcontextprotocol/inspector node ./bin/kubb-mcp.cjs",
    "start": "tsdown --watch",
    "start:mcp": "bun --watch ./src/server.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/adapter-oas": "workspace:*",
    "@kubb/core": "workspace:^",
    "@tmcp/adapter-valibot": "^0.1.7",
    "@tmcp/transport-stdio": "^0.5.1",
    "jiti": "^2.7.0",
    "tmcp": "^1.20.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@internals/shared": "workspace:*",
    "@internals/utils": "workspace:*",
    "@kubb/renderer-jsx": "workspace:*"
  },
  "peerDependencies": {
    "@kubb/renderer-jsx": "workspace:*"
  },
  "engines": {
    "node": ">=22.22"
  }
}
