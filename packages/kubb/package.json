{
  "name": "kubb",
  "version": "5.10.3",
  "description": "Turn your API spec into type-safe code. Generate TypeScript types, API clients, hooks, validators and mocks from a spec such as OpenAPI.",
  "keywords": [
    "api-client",
    "code-generator",
    "codegen",
    "faker",
    "kubb",
    "meta-framework",
    "msw",
    "plugin-system",
    "sdk-generator",
    "typescript",
    "zod"
  ],
  "homepage": "https://kubb.dev",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/kubb.git",
    "directory": "packages/kubb"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "bin": {
    "kubb": "bin/kubb.js"
  },
  "files": [
    "dist",
    "bin",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro.d.ts",
        "default": "./dist/astro.js"
      },
      "require": {
        "types": "./dist/astro.d.cts",
        "default": "./dist/astro.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.ts",
        "default": "./dist/esbuild.js"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    },
    "./farm": {
      "import": {
        "types": "./dist/farm.d.ts",
        "default": "./dist/farm.js"
      },
      "require": {
        "types": "./dist/farm.d.cts",
        "default": "./dist/farm.cjs"
      }
    },
    "./jsx": {
      "import": {
        "types": "./dist/jsx.d.ts",
        "default": "./dist/jsx.js"
      },
      "require": {
        "types": "./dist/jsx.d.cts",
        "default": "./dist/jsx.cjs"
      }
    },
    "./jsx/jsx-dev-runtime": {
      "import": {
        "types": "./dist/jsx/jsx-dev-runtime.d.ts",
        "default": "./dist/jsx/jsx-dev-runtime.js"
      },
      "require": {
        "types": "./dist/jsx/jsx-dev-runtime.d.cts",
        "default": "./dist/jsx/jsx-dev-runtime.cjs"
      }
    },
    "./jsx/jsx-runtime": {
      "import": {
        "types": "./dist/jsx/jsx-runtime.d.ts",
        "default": "./dist/jsx/jsx-runtime.js"
      },
      "require": {
        "types": "./dist/jsx/jsx-runtime.d.cts",
        "default": "./dist/jsx/jsx-runtime.cjs"
      }
    },
    "./kit": {
      "import": {
        "types": "./dist/kit.d.ts",
        "default": "./dist/kit.js"
      },
      "require": {
        "types": "./dist/kit.d.cts",
        "default": "./dist/kit.cjs"
      }
    },
    "./kit/testing": {
      "import": {
        "types": "./dist/kit/testing.d.ts",
        "default": "./dist/kit/testing.js"
      },
      "require": {
        "types": "./dist/kit/testing.d.cts",
        "default": "./dist/kit/testing.cjs"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt.d.ts",
        "default": "./dist/nuxt.js"
      },
      "require": {
        "types": "./dist/nuxt.d.cts",
        "default": "./dist/nuxt.cjs"
      }
    },
    "./rolldown": {
      "import": {
        "types": "./dist/rolldown.d.ts",
        "default": "./dist/rolldown.js"
      },
      "require": {
        "types": "./dist/rolldown.d.cts",
        "default": "./dist/rolldown.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.ts",
        "default": "./dist/rollup.js"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./rspack": {
      "import": {
        "types": "./dist/rspack.d.ts",
        "default": "./dist/rspack.js"
      },
      "require": {
        "types": "./dist/rspack.d.cts",
        "default": "./dist/rspack.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/adapter-oas": "workspace:*",
    "@kubb/cli": "workspace:*",
    "@kubb/core": "workspace:*",
    "@kubb/kit": "workspace:*",
    "@kubb/mcp": "workspace:*",
    "@kubb/parser-md": "workspace:*",
    "@kubb/parser-ts": "workspace:*",
    "@kubb/plugin-barrel": "workspace:*",
    "@kubb/renderer-jsx": "workspace:*",
    "@kubb/studio": "workspace:*",
    "unplugin-kubb": "workspace:*"
  },
  "devDependencies": {
    "@farmfe/core": "^1.7.11",
    "@internals/utils": "workspace:*",
    "@nuxt/kit": "^4.6.1",
    "@nuxt/schema": "^4.6.1",
    "esbuild": "^0.28.2",
    "rolldown": "^1.2.13",
    "rollup": "^4.64.5",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "webpack": "^5.111.1"
  },
  "peerDependencies": {
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=22.12"
  }
}
