exports[`JSON Schema output > outputOptionsSchema 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "group": {
      "description": "Groups generated files into subdirectories based on an OpenAPI tag or path segment.",
      "properties": {
        "name": {
          "description": "Returns the subdirectory name from the group key. Defaults to the camelCased tag for \`tag\` groups, or the first path segment as written in the spec for \`path\` groups.",
        },
        "type": {
          "description": "Property used to assign each operation to a group. \`'tag'\` uses the first tag, \`'path'\` uses the first segment of the operation's URL.",
          "enum": [
            "tag",
            "path",
          ],
          "type": "string",
        },
      },
      "required": [
        "type",
      ],
      "type": "object",
    },
    "output": {
      "description": "Output configuration shared by every plugin.",
      "properties": {
        "banner": {
          "anyOf": [
            {
              "type": "string",
            },
            {},
          ],
          "description": "Text prepended to every generated file. Useful for license headers, lint disables, or \`@ts-nocheck\` directives. Pass a function to compute the banner from the file's \`BannerMeta\`.",
        },
        "barrel": {
          "anyOf": [
            {
              "properties": {
                "nested": {
                  "description": "Generate an \`index.ts\` in every sub-directory, each re-exporting only what's directly inside it.",
                  "type": "boolean",
                },
                "type": {
                  "description": "Export strategy for the plugin's barrel files. \`'all'\` uses wildcard exports, \`'named'\` uses explicit exports.",
                  "enum": [
                    "all",
                    "named",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
            {
              "const": false,
              "type": "boolean",
            },
          ],
          "description": "Barrel configuration for this plugin's output. Set to \`{ type: 'named' | 'all' }\` to opt into a barrel, or \`false\` to disable it. Falls back to \`config.output.barrel\` when omitted.",
        },
        "footer": {
          "anyOf": [
            {
              "type": "string",
            },
            {},
          ],
          "description": "Text appended at the end of every generated file. Pass a function to compute the footer from the file's \`BannerMeta\`.",
        },
        "mode": {
          "description": "How generated code is consolidated into files. \`'file'\` writes everything into a single file, \`'directory'\` writes one file per operation or schema under \`path\`. Defaults to \`'file'\` when \`path\` carries an extension and \`'directory'\` when it does not.",
          "enum": [
            "directory",
            "file",
          ],
          "type": "string",
        },
        "path": {
          "description": "Directory where the plugin writes its generated code, resolved against the global \`output.path\` set on \`defineConfig\`. With \`mode: 'file'\`, this is the full output file path and must include the extension (e.g. \`'types.ts'\`, \`'models.py'\`).",
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
  },
  "type": "object",
}
`;

