{
  "name": "@kubb/adapter-oas",
  "version": "5.9.1",
  "description": "OpenAPI and Swagger adapter for Kubb. Parses and validates OAS 2.0/3.x specifications into a @kubb/ast RootNode for downstream code generation plugins.",
  "keywords": [
    "adapter",
    "codegen",
    "kubb",
    "meta-framework",
    "oas",
    "openapi",
    "swagger",
    "typescript"
  ],
  "homepage": "https://kubb.dev/extensions/kubb-labs/adapter-oas",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/kubb.git",
    "directory": "packages/adapter-oas"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "dist",
    "kubb-extension.json",
    "docs",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./kubb-extension.json": "./kubb-extension.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/kit": "workspace:*",
    "@readme/openapi-parser": "^9.1.0",
    "@scalar/openapi-upgrader": "^0.4.3",
    "api-ref-bundler": "0.5.1",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@internals/utils": "workspace:*",
    "@types/json-schema": "^7.0.15",
    "openapi-types": "^12.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "inlinedDependencies": {
    "@types/json-schema": "7.0.15",
    "openapi-types": "12.1.3"
  }
}
