{
  "name": "@kubb/cli",
  "version": "5.14.1",
  "description": "Official CLI for Kubb. Run kubb generate, kubb init, kubb validate, kubb studio, and kubb mcp to manage the full code generation lifecycle.",
  "keywords": [
    "cli",
    "code-generator",
    "codegen",
    "kubb",
    "meta-framework",
    "sdk-generator",
    "typescript"
  ],
  "homepage": "https://kubb.dev",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/kubb.git",
    "directory": "packages/cli"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "bin": {
    "kubb": "bin/kubb.js"
  },
  "files": [
    "dist",
    "bin",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@gunshi/plugin-dryrun": "^0.37.3",
    "@kubb/core": "workspace:*",
    "chokidar": "^6.0.0",
    "gunshi": "^0.37.3",
    "jiti": "^2.7.0",
    "tinyexec": "catalog:",
    "verkit": "^0.5.0",
    "yuku-parser": "^0.19.0"
  },
  "devDependencies": {
    "@internals/shared": "workspace:*",
    "@internals/utils": "workspace:*",
    "@kubb/adapter-oas": "workspace:*",
    "@kubb/studio": "workspace:*"
  },
  "peerDependencies": {
    "@kubb/adapter-oas": "workspace:*",
    "@kubb/mcp": "workspace:*",
    "@kubb/studio": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kubb/adapter-oas": {
      "optional": true
    },
    "@kubb/mcp": {
      "optional": true
    },
    "@kubb/studio": {
      "optional": true
    }
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=22.22"
  }
}
