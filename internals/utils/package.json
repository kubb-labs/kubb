{
  "name": "@internals/utils",
  "version": "0.0.1",
  "private": true,
  "description": "Domain-agnostic utility helpers shared across all Kubb workspace packages. Not intended for public use.",
  "keywords": [
    "internal",
    "kubb",
    "typescript"
  ],
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/kubb.git",
    "directory": "internals/utils"
  },
  "files": [
    "src",
    "dist",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {}
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tinyexec": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
